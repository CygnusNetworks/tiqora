# Real OTRS/Znuny peer image for golden-master (manual multi-peer).
#
# No official znuny image exists — build from a release tree at the repo root.
#
#   docker build -f tests/golden/Dockerfile.znuny \
#     --build-arg SOURCE_DIR=znuny-6.5.22 \
#     -t tiqora-golden-znuny-6.5 .
#
# SOURCE_DIR must be a real directory in the build context (not an external
# symlink). install_home inside the image is always /opt/otrs for one layout;
# Console is auto-detected (otrs.Console.pl vs znuny.Console.pl).

ARG SOURCE_DIR=znuny-6.5.22

FROM debian:bookworm-slim

ARG SOURCE_DIR

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    OTRS_USER=otrs \
    OTRS_GROUP=otrs \
    PERL5LIB=/opt/otrs:/opt/otrs/Kernel/cpan-lib:/opt/otrs/Custom \
    GOLDEN_SOURCE_DIR=${SOURCE_DIR}

# System + Perl modules for a MySQL-backed install (otrs.CheckModules.pl set).
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
        apache2 \
        libapache2-mod-perl2 \
        libapache-dbi-perl \
        libapache2-reload-perl \
        perl \
        cron \
        procps \
        default-mysql-client \
        ca-certificates \
        curl \
        libarchive-zip-perl \
        libauthen-sasl-perl \
        libauthen-ntlm-perl \
        libcrypt-eksblowfish-perl \
        libcrypt-jwt-perl \
        libcrypt-openssl-x509-perl \
        libcss-minifier-xs-perl \
        libdata-uuid-perl \
        libtimedate-perl \
        libdatetime-perl \
        libdatetime-timezone-perl \
        libdbi-perl \
        libdbd-mysql-perl \
        libencode-hanextra-perl \
        libhash-merge-perl \
        libical-parser-perl \
        libio-socket-ssl-perl \
        libjavascript-minifier-xs-perl \
        libjson-xs-perl \
        liblist-moreutils-perl \
        libmail-imapclient-perl \
        libmoo-perl \
        libnet-dns-perl \
        libnet-ldap-perl \
        libpackage-stash-perl \
        libspreadsheet-xlsx-perl \
        libtemplate-perl \
        libtext-csv-xs-perl \
        libxml-libxml-perl \
        libxml-libxslt-perl \
        libxml-parser-perl \
        libyaml-libyaml-perl \
        libcpanel-json-xs-perl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -r -m -d /opt/otrs -s /bin/bash "$OTRS_USER" \
    && usermod -a -G "$OTRS_USER" www-data

# Peer release tree → fixed install home (simplifies entrypoint + helpers).
COPY --chown=otrs:otrs ${SOURCE_DIR}/ /opt/otrs/

# Prefer znuny.Console.pl when present; always expose bin/console.pl for scripts.
RUN set -e; \
    if [ -f /opt/otrs/bin/znuny.Console.pl ]; then \
      ln -sfn znuny.Console.pl /opt/otrs/bin/console.pl; \
    elif [ -f /opt/otrs/bin/otrs.Console.pl ]; then \
      ln -sfn otrs.Console.pl /opt/otrs/bin/console.pl; \
    else \
      echo "ERROR: no Console.pl in peer source" >&2; exit 1; \
    fi; \
    if [ -f /opt/otrs/bin/znuny.SetPermissions.pl ]; then \
      ln -sfn znuny.SetPermissions.pl /opt/otrs/bin/SetPermissions.pl; \
    elif [ -f /opt/otrs/bin/otrs.SetPermissions.pl ]; then \
      ln -sfn otrs.SetPermissions.pl /opt/otrs/bin/SetPermissions.pl; \
    fi

COPY tests/golden/znuny-entrypoint.sh /usr/local/bin/znuny-entrypoint.sh
COPY tests/golden/Config.pm.tmpl /opt/otrs/Kernel/Config.pm.tmpl
RUN chmod +x /usr/local/bin/znuny-entrypoint.sh

# Apache + perl-startup: Znuny 7.x ships /opt/znuny paths; we always install at /opt/otrs.
# Rewrite install root and normalize ScriptAlias to /otrs/ so one healthcheck + GI URL works.
RUN set -e; \
    for f in /opt/otrs/scripts/apache2-httpd.include.conf \
             /opt/otrs/scripts/apache2-httpd-mp1-or-mp2.include.conf \
             /opt/otrs/scripts/apache2-perl-startup.pl \
             /opt/otrs/scripts/apache2-httpd-plack-proxy.conf; do \
      [ -f "$f" ] || continue; \
      sed -i \
        -e 's|/opt/znuny|/opt/otrs|g' \
        -e 's|ScriptAlias /znuny/|ScriptAlias /otrs/|g' \
        -e 's|Alias /znuny-web/|Alias /otrs-web/|g' \
        -e 's|<Location /znuny>|<Location /otrs>|g' \
        -e 's|<Location /znuny/|<Location /otrs/|g' \
        -e 's|ErrorDocument 403 /znuny/|ErrorDocument 403 /otrs/|g' \
        "$f"; \
    done; \
    INC=""; \
    for f in /opt/otrs/scripts/apache2-httpd.include.conf \
             /opt/otrs/scripts/apache2-httpd-mp1-or-mp2.include.conf; do \
      if [ -f "$f" ]; then INC="$f"; break; fi; \
    done; \
    if [ -n "$INC" ]; then \
      cp "$INC" /etc/apache2/conf-available/znuny.conf; \
      a2enconf znuny; \
    fi; \
    a2enmod perl headers deflate filter || true; \
    # Stable path for GenericTicketConnectorREST (location varies by release).
    mkdir -p /opt/otrs/var/webservices/examples; \
    DEST=/opt/otrs/var/webservices/examples/GenericTicketConnectorREST.yml; \
    if [ ! -f "$DEST" ]; then \
      for src in \
        /opt/otrs/scripts/test/sample/Webservice/GenericTicketConnectorREST.yml \
        /opt/otrs/scripts/test/sample/webservice/GenericTicketConnectorREST.yml; do \
        if [ -f "$src" ]; then cp "$src" "$DEST"; break; fi; \
      done; \
    fi; \
    # ServerName quiet + apache can start without DNS
    printf 'ServerName znuny.golden.local\n' > /etc/apache2/conf-available/servername.conf; \
    a2enconf servername || true

WORKDIR /opt/otrs
EXPOSE 80
ENTRYPOINT ["/usr/local/bin/znuny-entrypoint.sh"]
