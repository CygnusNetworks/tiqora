<div class="mod modSidebarWidget">
    <div class="inner">
        <div class="sidebarWidgetTitle">
            <h3>[% Translate("Betroffene CIs (Tiqora)") | html %]</h3>
        </div>
        <div class="sidebarWidgetContent">
            <div class="mod modTiqoraITSM">
                <div class="inner">
                    <ul class="list">
                        [% RenderBlockStart("CI") %]
                        <li class="TiqoraITSMCI">
                            [% IF Data.URL %]
                            <a href="[% Data.URL | html %]" target="_blank" rel="noopener noreferrer" title="[% Data.ClassName | html %]">[% Data.Number | html %] [% Data.Name | html %]</a>
                            [% ELSE %]
                            <span title="[% Data.ClassName | html %]">[% Data.Number | html %] [% Data.Name | html %]</span>
                            [% END %]
                            <br/>
                            <span class="TiqoraITSMState TiqoraITSM[% Data.DeplClass | html %]" style="color: [% IF Data.DeplClass == 'Operational' %]#2e8b57[% ELSIF Data.DeplClass == 'Warning' %]#e08a00[% ELSIF Data.DeplClass == 'Incident' %]#c62828[% ELSE %]#777[% END %];" title="[% Translate("Deployment State") | html %]">&#9679; [% Data.DeplState | html %]</span>
                            <span class="TiqoraITSMState TiqoraITSM[% Data.InciClass | html %]" style="color: [% IF Data.InciClass == 'Operational' %]#2e8b57[% ELSIF Data.InciClass == 'Warning' %]#e08a00[% ELSIF Data.InciClass == 'Incident' %]#c62828[% ELSE %]#777[% END %];" title="[% Translate("Incident State") | html %]">&#9679; [% Data.InciState | html %]</span>
                            [% IF Data.LinkType %]<span class="Light">([% Data.LinkType | html %])</span>[% END %]
                        </li>
                        [% RenderBlockEnd("CI") %]
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
