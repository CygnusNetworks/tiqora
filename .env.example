# Copy to .env and adjust. Never commit real secrets.

TIQORA_ENV=development
TIQORA_DEBUG=true
TIQORA_LOG_LEVEL=INFO
TIQORA_SECRET_KEY=dev-only-change-me

# Use one of:
DATABASE_URL=postgresql+asyncpg://tiqora:tiqora@localhost:5432/tiqora
# DATABASE_URL=mysql+aiomysql://tiqora:tiqora@localhost:3306/tiqora

REDIS_URL=redis://localhost:6379/0
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=tiqora-dev-master-key

# Public browser URL used for notification and password-setup links (also set on workers).
TIQORA_PUBLIC_BASE_URL=http://localhost:5173
TIQORA_CORS_ORIGINS=http://localhost:5173,http://localhost:8000
TIQORA_SCHEMA_OWNERSHIP=false

# Customer portal master switch. false hard-disables the portal (API 404s,
# "/", "/portal", and "/portal/login" all go to the agent login) and locks
# the admin-UI switch.
TIQORA_PORTAL_ENABLED=true
