#!/usr/bin/env python3
"""Refresh .git/info/pii-hashes.json from the production database.

A fresh random key stays on this machine; the production container only gets
the key and sends back HMAC-SHA256 digests of real customer and agent
identifiers. No plaintext leaves production. .githooks/pii_check.py uses the
digests to refuse commits, pushes and edits that contain real personal data.

Configuration (environment):
    TIQORA_PII_SYNC_SSH        ssh target (default root@docker-virt6.cygnusnet.de)
    TIQORA_PII_SYNC_CONTAINER  container with DATABASE_URL (default tiqora-api)
    TIQORA_PII_SYNC_PRE        shell command run first, e.g. a port knock
"""

from __future__ import annotations

import json
import os
import secrets
import subprocess
import sys
from pathlib import Path

REMOTE_CODE = r'''
import hashlib, hmac, json, os, re, sys, urllib.parse as up
import pymysql

key = bytes.fromhex(sys.stdin.readline().strip())
u = up.urlparse(os.environ["DATABASE_URL"].replace("mysql+aiomysql", "mysql"))
conn = pymysql.connect(host=u.hostname, port=u.port or 3306, user=u.username,
                       password=up.unquote(u.password or ""), database=u.path[1:], charset="utf8mb4")
cid_re = re.compile(r"^[a-z]{1,3}-?\d{5,10}$")
word_re = re.compile(r"^[A-Za-zÄÖÜäöüß]{3,}(-[A-Za-zÄÖÜäöüß]{3,})?$")
out = {k: set() for k in ("email", "wp", "phone", "cid", "name")}

def add(kind, value):
    out[kind].add(hmac.new(key, f"{kind}:{value}".encode(), hashlib.sha256).hexdigest())

def phone(raw):
    d = re.sub(r"\D", "", raw or "")
    if d.startswith("0049"): d = "0" + d[4:]
    elif d.startswith("49") and len(d) > 10: d = "0" + d[2:]
    if len(d) >= 7: add("phone", d)

def name(first, last):
    first = (first or "").strip().split(" ")[0]
    last = (last or "").strip()
    if word_re.match(first) and word_re.match(last):
        add("name", f"{first} {last}".lower())

def email(raw):
    if raw and "@" in raw: add("email", raw.strip().lower())

def cid(raw):
    base = (raw or "").split("#")[0].strip().lower()
    if cid_re.match(base): add("cid", base)

with conn.cursor() as cur:
    cur.execute("SELECT login, email, first_name, last_name, wpnum, telephone, phone, mobile, customer_id FROM customer_user")
    for login, mail, first, last, wpnum, tel, ph, mob, customer in cur.fetchall():
        email(mail); cid(login); cid(customer); name(first, last)
        d = re.sub(r"\D", "", wpnum or "")
        if len(d) == 10: add("wp", d)
        for p in (tel, ph, mob): phone(p)
    cur.execute("SELECT login, first_name, last_name FROM users")
    for login, first, last in cur.fetchall():
        name(first, last); cid(login)
    cur.execute("SELECT preferences_value FROM user_preferences WHERE preferences_key = 'UserEmail'")
    for (value,) in cur.fetchall():
        email(value.decode() if isinstance(value, bytes) else value)

print(json.dumps({k: sorted(v) for k, v in out.items()}))
'''


def main() -> int:
    target = os.environ.get("TIQORA_PII_SYNC_SSH", "root@docker-virt6.cygnusnet.de")
    container = os.environ.get("TIQORA_PII_SYNC_CONTAINER", "tiqora-api")
    pre = os.environ.get("TIQORA_PII_SYNC_PRE")
    info = Path(
        subprocess.run(["git", "rev-parse", "--git-common-dir"], capture_output=True, text=True, check=True).stdout.strip()
    ) / "info"

    key = secrets.token_hex(32)
    if pre:
        subprocess.run(pre, shell=True, check=True)
    upload = (
        f"cat > /tmp/pii_hash_sync.py && docker cp /tmp/pii_hash_sync.py {container}:/tmp/pii_hash_sync.py"
        " && rm -f /tmp/pii_hash_sync.py"
    )
    # The file was copied in as root; only root may delete it again.
    run = (
        f"docker exec -i {container} /app/.venv/bin/python /tmp/pii_hash_sync.py;"
        f" rc=$?; docker exec -u 0 {container} rm -f /tmp/pii_hash_sync.py; exit $rc"
    )
    # Two ssh calls: the first uploads the code, the second streams the key on stdin.
    ssh = ["ssh", "-o", "ConnectTimeout=10", target]
    subprocess.run([*ssh, upload], input=REMOTE_CODE, text=True, check=True)
    result = subprocess.run([*ssh, run], input=key + "\n", capture_output=True, text=True)
    if result.returncode != 0:
        print(result.stderr[-2000:], file=sys.stderr)
        return result.returncode
    hashes = json.loads(result.stdout)
    path = info / "pii-hashes.json"
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps({"key": key, "hashes": hashes}), encoding="utf-8")
    tmp.chmod(0o600)
    tmp.replace(path)
    counts = ", ".join(f"{k} {len(v)}" for k, v in hashes.items())
    print(f"pii-hash-sync: wrote {path} ({counts})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
